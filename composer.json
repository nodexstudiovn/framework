{
    "name": "nodex-studio/framework",
    "description": "NodeX Studio PHP Framework v1.1.0",
    "type": "project",
    "version": "1.2.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Nguyễn Anh Kiệt",
            "email": "nanhkiet2006.dev@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/database": "^13.35",
        "illuminate/events": "^13.35",
        "illuminate/filesystem": "^13.35",
        "illuminate/pagination": "^13.35",
        "illuminate/translation": "^13.35",
        "illuminate/validation": "^13.35",
        "illuminate/view": "^13.35"
    },
    "autoload": {
        "psr-4": {
            "NodeX\\": "src/",
            "App\\": "app/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
