APP_NAME="NodeX Studio"
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.1.0
APP_URL=http://localhost:8000

# Database Configuration (MySQL — database: nodexvn)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nodexvn
DB_NAME=nodexvn
DB_USER=root
DB_USERNAME=root
DB_PASSWORD=

# Redis Configuration (Local Default Port: 6379)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# Queue Configuration (Driver: auto, redis, file, sync)
QUEUE_CONNECTION=auto
